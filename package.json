{
  "name": "shesha-config-diff",
  "version": "0.1.0",
  "description": "A local-first visual diff tool for exported Shesha forms.",
  "author": "Welcome Galane",
  "license": "Apache-2.0",
  "keywords": [
    "shesha",
    "configuration",
    "diff",
    "forms",
    "developer-tools"
  ],
  "type": "module",
  "private": false,
  "scripts": {
    "build": "tsc -b && vite build",
    "capture:screenshot": "node scripts/capture-screenshot.mjs",
    "dev": "vite",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "type-check": "tsc -b --pretty false"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.6.6",
    "antd-style": "^4.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "29.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
